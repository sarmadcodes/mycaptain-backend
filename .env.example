NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to call the API (app web build, partner site, admin).
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/my-captain
# Required in production. Leave empty in development to use the built-in memory store.
REDIS_URL=

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_PEPPER=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS: "console" logs codes (development only). Production provider is wired in Phase 3.
SMS_PROVIDER=console

# First admin account, created by `npm run seed`.
SEED_ADMIN_PHONE=3001112223
SEED_ADMIN_PASSWORD=
